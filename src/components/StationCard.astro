---
import type { Station } from "../data/stations";

interface Props {
  station: Station;
}

const { station } = Astro.props;
---

<article class="card">
  <p class="kicker">{station.band} · {station.channel}</p>
  <h2><a href={`/${station.slug}`}>{station.callsign}</a></h2>
  <p class="card-freq"><span>Output</span>{station.outputMHz} MHz</p>
  <p>{station.summary}</p>
  <a class="text-link" href={`/${station.slug}`}>Programming details</a>
</article>
