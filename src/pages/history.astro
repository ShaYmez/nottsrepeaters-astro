---
import Base from "../layouts/Base.astro";
import { history, historyPhotos } from "../data/history";
---

<Base
  title="History"
  description="How GB7NR, GB3NF, and GB3NM came to be the Nottingham repeater group."
>
  <p class="kicker">1977–2026</p>
  <h1>History</h1>
  <p class="lead">How the three stations came to be. Open a year for the rest of the story.</p>
  <div class="photo-grid">
    {
      historyPhotos.map((photo) => (
        <figure class="photo">
          <img src={photo.src} alt={photo.alt} />
          <figcaption>{photo.caption}</figcaption>
        </figure>
      ))
    }
  </div>
  <div class="stack">
    {
      history.map((entry) => (
        <article class="history-item">
          <time datetime={entry.when}>{entry.when}</time>
          <div>
            <p>{entry.text}</p>
            <details class="history-more">
              <summary>
                <span class="more-closed">Read more</span>
                <span class="more-open">Close</span>
              </summary>
              {entry.more.map((paragraph) => <p>{paragraph}</p>)}
            </details>
          </div>
        </article>
      ))
    }
  </div>
</Base>
